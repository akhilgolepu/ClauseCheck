# Copy to .env and fill in. .env is gitignored.

# Matches the db service in docker-compose.yml (inside compose, the API uses host "db")
DATABASE_URL=postgresql://clausecheck:clausecheck@localhost:5432/clausecheck

# LLM providers (chosen in Phase 3; leave blank until then)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
